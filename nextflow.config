// nextflow.config

params {

	//general settings
	output_dir	= 'results'
	meta_file	= 'meta_data/meta_sheet.csv'	// sample file with header having sampleId, file_name...
	basecaller	= 'Dorado'		// availabel ['Dorado', 'Guppy']
	rawfile_type	= 'fastq'		// available ['fastq', 'fast5_pod5']
	rawfile_dir	=  "${baseDir}/test_data/fastq_pass"
	fastq_dir	= 'raw_files/fastq'
	primer_schema	= "${projectDir}/meta_data/primer-schemes"
	kit_name	= 'EXP-NBD196' // for multipel kit_name use this format '"EXP-NBD104 EXP-NBD114"'
	fq_extension	= '.fastq'
	script		= 'scripts'
	threads		= 5 			// number of cpus to use (for medaka, samtools, minimap2 etc)
	run_name = "test_run"

	// dorado setting
	dorado_dir	= '/user1/task_dir/tools/dorado-0.4.3-linux-x64'
	dorado_model_path = '/user1/task_dir/tools/dorado-0.4.3-linux-x64/models'
	dorado_config	= 'dna_r9.4.1_e8_fast@v3.4'
	//dorado_config	= 'dna_r10.4.1_e8.2_400bps_fast@v4.2.0'
	dorado_run_mode	= 'cuda:0'

	//guppy settings
	guppy_dir	= '/user1/task_dir/tools/ont-guppy'
	guppy_config	= 'dna_r9.4.1_450bps_fast.cfg'	// change according to your data
	guppy_cpu_threads	= 4
	guppy_run_mode	= 'cuda:all' 			// use 'cuda:0' for single device

	
	seq_len		= 350 //Minimum read length. Reads shorter than this will be skipped
    seq_max_len = 700
    
	//medaka settings
	//medaka_model	= 'r941_min_fast_g303'
	//medaka_normalise	= 200		//default value by medaka
	
    mask_depth 	= 20 //how many reads cover a particular reference position (also used as vcf_filter --min-depth)

	//align_trim settings
	normalise	= 100	// downsample to this many reads per amplicon
	primer_match_threshold	= 35	// max distance (bp) between a read end and its primer site
	min_mapq	= 20	// reads below this mapping quality are dropped

	//vcf_filter settings (variants failing these are masked with N, except where noted)
	min_variant_quality	= 10	// clair3 QUAL cutoff
	min_allele_frequency	= 0.6	// AF needed for a variant to enter the consensus
	min_mask_allele_frequency	= 0.1	// below this AF the variant is discarded (reference base kept)
	min_frameshift_quality	= 50	// QUAL needed for frameshifting indels
	min_minor_allele_count	= 4	// fewer alt-supporting reads than this -> discarded (reference base kept)

	//clair3 settings
	model_path	= '/opt/miniforge/envs/clair3env/bin/models/r1041_e82_400bps_hac_v520'
}

conda.enabled = true
docker.enabled = true
docker.runOptions = "-v$PWD:$PWD -w $PWD" //"-v ${baseDir}:${baseDir}"
docker.temp = 'auto'

executor {
  name		= 'local'
  queueSize	= 2 // Limits the executor to run one process at a time
}

def arch_type = System.getProperty('os.arch').toLowerCase()

def docker_image_type() {
		def architecture = System.getProperty('os.arch').toLowerCase()
    if (architecture =="aarch64" || architecture == "arm64") {
        return 'rage2025/artic-nf-arm64:v2.0'
    }
    else if (architecture == "amd64" || architecture == "x86_64") {
        return 'rage2025/artic-nf-amd64:v2.0'
    }
    else {
        throw new RuntimeException("Unsupported architecture: " + architecture)
    }
}

params.arch_type = arch_type
def container_name = docker_image_type()

profiles {
    docker {
        process {
            withName: PLEX_FQ_FILES {
                container = container_name
            }
            withName: PLEX_DIRS {
                container = container_name
            }
            withName: MINIMAP2 {
                container = container_name
            }
            withName: ALIGN_TRIM {
                container = container_name
            }
            withName: SPLIT_UNMATCHED {
                container = container_name
            }
            withName: CLAIR3 {
                container = container_name
            }
            withName: CLAIR3_2 {
                container = container_name
            }
            withName: CLAIR3_UNMATCHED {
                container = container_name
            }
            withName: COMPRESS_AND_INDEX_VCF {
                container = container_name
            }
            withName: BCFTOOLS_NORM {
                container = container_name
            }
           
            withName: VCF_MERGE {
                container = container_name
            }
    
            withName: VCF_FILTER {
                container = container_name
            }
            withName: MAKE_DEPTH_MASK {
                container = container_name
            }
            withName: MASK {
                container = container_name
            }
            withName: BCFTOOLS_CONSENSUS {
                container = container_name
            }
            withName: FASTA_HEADER {
                container = container_name
            }
            withName: CONCAT_FOR_MUSCLE {
                container = container_name
            }
            withName: MUSCLE {
                container = container_name
            }
            withName: CONCAT {
                container = container_name
            }
            withName: MAFFT {
                container = container_name
            }
            withName: SUMMARY_STATS {
                container = container_name
            }
	    withName: REPORT {
		container = container_name
	    }
        }
    }

    conda {
        process {
            withName: PLEX_FQ_FILES {
                conda = 'envs/biopython.yml'
            }
            withName: PLEX_DIRS {
                conda = 'envs/biopython.yml'
            }
            withName: MINIMAP2 {
                conda = 'envs/minimap2.yml'
            }
            withName: ALIGN_TRIM_1 {
                conda = 'envs/pyvcf.yml'
            }
            withName: ALIGN_TRIM_2 {
                conda = 'envs/pyvcf.yml'
            }
            withName: MEDAKA_1 {
                conda = 'envs/medaka.yml'
            }
            withName: MEDAKA_2 {
                conda = 'envs/medaka.yml'
            }
            withName: MEDAKA_SNP_1 {
                conda = 'envs/medaka.yml'
            }
            withName: MEDAKA_SNP_2 {
                conda = 'envs/medaka.yml'
            }
            withName: VCF_MERGE {
                conda = 'envs/pyvcf.yml'
            }
            withName: LONGSHOT {
                conda = 'envs/longshot.yml'
            }
	        withName: VCF_FILTER {
              conda = 'envs/tabix.yml'
            }
            withName: MAKE_DEPTH_MASK {
                conda = 'envs/pyvcf.yml'
            }
            withName: MASK {
                conda = 'envs/pyvcf.yml'
            }
            withName: BCFTOOLS_CONSENSUS {
                conda = 'envs/medaka.yml'
            }
            withName: FASTA_HEADER {
                conda = 'envs/pyvcf.yml'
            }
            withName: CONCAT_FOR_MUSCLE {
                conda = 'envs/pyvcf.yml'
            }
            withName: MAFFT {
                conda = 'envs/mafft.yml'
            }
            withName: SUMMARY_STATS {
                conda = 'envs/datamash.yml'
            }
	    withName: REPORT {
		conda = 'envs/report.yml'
	    }
        }
    }
}

