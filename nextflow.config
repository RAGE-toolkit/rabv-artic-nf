manifest {

    name	= 'RAGE-toolkit/rabv-artic-nf'
    author	= 'RAGE-toolkit'
    homePage	= 'https://github.com/RAGE-toolkit/rabv-artic-nf'
    description	= 'Basecalling and consensus alignment'
    mainScript	= 'main.nf'
    nextflowVersion	= '23.10.0.5889'
    version	= 'v2.0.0'

}
